{
  "name": "axon-simple",
  "productName": "灵犀平台集成示例",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/main.js",
  "description": "平台功能集成示例与接口契约",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "debug": "npm run build && node scripts/debug.mjs",
    "dev": "npm run debug",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run typecheck && vite build && npm run build:main",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "mock": "node scripts/mock-aihub.mjs",
    "test": "node --test src/main/features/connectors/connectorService.test.mjs"
  },
  "dependencies": {
    "electron": "42.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3",
    "vite": "^6.3.4"
  }
}
